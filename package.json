{
  "name": "ding-dong-dang",
  "productName": "딩동댕",
  "version": "0.1.0",
  "private": true,
  "description": "정해진 시각에 수업 종을 울리는 데스크톱 앱",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "sounds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-bell-sounds.mts",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-icons.mts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --win --publish never",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:headless": "electron-vite build && cross-env DDD_HEADLESS=1 playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/release.mts",
    "update:keygen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/update-keygen.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "electron": "~45.3.3",
    "electron-builder": "~26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "js-yaml": "^4.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "~6.8.11"
  }
}
